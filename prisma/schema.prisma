// Orchestra database schema. Models (symphonies, backtests, rebalance runs)
// are added with the features that need them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Candle width. Daily candles open at 00:00 UTC.
enum CandleInterval {
  H1
  D1
}

/// Mints whose price history /api/cron/prices keeps up to date.
model TrackedMint {
  mint       String    @id
  addedAt    DateTime  @default(now()) @map("added_at")
  /// Last time the sync job finished this mint (successfully or not).
  lastSyncAt DateTime? @map("last_sync_at")
  /// GeckoTerminal pool whose candles price this mint, picked once (busiest
  /// mature pool) so the series never switches pools. Unused with Birdeye.
  pricePool  String?   @map("price_pool")
  /// Error from the last sync, cleared on success.
  lastError  String?   @map("last_error")

  @@map("tracked_mints")
}

/// Closed USD OHLCV candles from GeckoTerminal or Birdeye (docs/market-data.md). The in-progress
/// candle is never stored, so rows are immutable once written.
model Candle {
  mint      String
  interval  CandleInterval
  openTime  DateTime       @map("open_time") @db.Timestamptz(3)
  open      Float
  high      Float
  low       Float
  close     Float
  /// Volume in token units (Birdeye only; GeckoTerminal reports USD volume).
  volume    Float?
  volumeUsd Float?         @map("volume_usd")

  @@id([mint, interval, openTime])
  @@map("candles")
}

/// Work-in-progress symphonies from /create, autosaved while editing. The id
/// is generated by the browser and acts as the only key: anyone holding it can
/// read and overwrite the draft (there are no accounts yet).
model SymphonyDraft {
  id        String   @id @db.Uuid
  name      String
  /// A structurally valid Symphony (schema.ts); may still fail validateSymphony.
  symphony  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("symphony_drafts")
}
