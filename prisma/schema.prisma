// Orchestra database schema. Models (symphonies, backtests, rebalance runs)
// are added with the features that need them.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Candle width. Daily candles open at 00:00 UTC.
enum CandleInterval {
  H1
  D1
}

/// Mints whose price history /api/cron/prices keeps up to date.
model TrackedMint {
  mint       String    @id
  addedAt    DateTime  @default(now()) @map("added_at")
  /// Last time the sync job finished this mint (successfully or not).
  lastSyncAt DateTime? @map("last_sync_at")
  /// GeckoTerminal pool whose candles price this mint, picked once (busiest
  /// mature pool) so the series never switches pools. Unused with Birdeye.
  pricePool  String?   @map("price_pool")
  /// Error from the last sync, cleared on success.
  lastError  String?   @map("last_error")

  @@map("tracked_mints")
}

/// Closed USD OHLCV candles from GeckoTerminal or Birdeye (docs/market-data.md). The in-progress
/// candle is never stored, so rows are immutable once written.
model Candle {
  mint      String
  interval  CandleInterval
  openTime  DateTime       @map("open_time") @db.Timestamptz(3)
  open      Float
  high      Float
  low       Float
  close     Float
  /// Volume in token units (Birdeye only; GeckoTerminal reports USD volume).
  volume    Float?
  volumeUsd Float?         @map("volume_usd")

  @@id([mint, interval, openTime])
  @@map("candles")
}

/// Work-in-progress symphonies from /create, autosaved while editing. The id
/// is generated by the browser and acts as the only key: anyone holding it can
/// read and overwrite the draft (there are no accounts yet).
model SymphonyDraft {
  id        String   @id @db.Uuid
  name      String
  /// A structurally valid Symphony (schema.ts); may still fail validateSymphony.
  symphony  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("symphony_drafts")
}

enum InvestmentStatus {
  active
  paused
  closed
}

enum RunStatus {
  planned
  executing
  completed
  partial
  cancelled
}

enum LegStatus {
  pending
  quoted
  executing
  succeeded
  failed
  skipped
}

/// A live symphony. There is no contract: the owner's wallet balances of the
/// symphony's mints (plus USDC) are the portfolio; every trade is signed by
/// the owner's wallet (docs/invest.md).
model Investment {
  id                String           @id @default(uuid()) @db.Uuid
  /// Owner wallet (base58), proven by Sign-In With Solana.
  owner             String
  name              String
  /// The symphony as it was when invested; later draft edits don't change it.
  symphony          Json
  sourceDraftId     String?          @map("source_draft_id") @db.Uuid
  /// RebalanceRule (src/lib/backtest/types.ts).
  rebalance         Json
  /// Legs whose weight is within this many points of target are skipped.
  driftThresholdPct Float            @map("drift_threshold_pct")
  status            InvestmentStatus @default(active)
  notifyEmail       String?          @map("notify_email")
  /// {mint: whole-token units} after the last rebalance.
  holdings          Json?
  holdingsAt        DateTime?        @map("holdings_at")
  nextDueAt         DateTime?        @map("next_due_at")
  lastRebalancedAt  DateTime?        @map("last_rebalanced_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  runs              RebalanceRun[]
  notifications     Notification[]

  @@index([owner])
  @@index([status, nextDueAt])
  @@map("investments")
}

/// One rebalance: the plan it executes and its legs, in order.
model RebalanceRun {
  id           String         @id @default(uuid()) @db.Uuid
  investmentId String         @map("investment_id") @db.Uuid
  investment   Investment     @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  status       RunStatus      @default(planned)
  /// RebalancePlan (src/lib/invest/plan.ts) plus the balances, prices and target it came from.
  plan         Json
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  completedAt  DateTime?      @map("completed_at")
  legs         RebalanceLeg[]

  @@index([investmentId, createdAt])
  @@map("rebalance_runs")
}

/// One swap of a run (token → USDC or USDC → token) and what actually happened.
model RebalanceLeg {
  id               String       @id @default(uuid()) @db.Uuid
  runId            String       @map("run_id") @db.Uuid
  run              RebalanceRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  index            Int
  side             String
  /// The non-USDC token.
  mint             String
  inputMint        String       @map("input_mint")
  outputMint       String       @map("output_mint")
  plannedUsd       Float        @map("planned_usd")
  plannedAmount    String       @map("planned_amount")
  full             Boolean      @default(false)
  status           LegStatus    @default(pending)
  /// Input amount (base units) sized from balances right before quoting.
  amount           String?
  requestId        String?      @map("request_id")
  /// The unsigned order transaction (base64), to check the wallet signed exactly it.
  orderTransaction String?      @map("order_transaction")
  /// Quote shown when signing: outAmount, priceImpact, feeBps, router.
  quote            Json?
  signature        String?
  inputAmount      String?      @map("input_amount")
  outputAmount     String?      @map("output_amount")
  /// USDC per whole token actually paid or received.
  realizedPrice    Float?       @map("realized_price")
  error            String?
  /// Set when we couldn't learn whether a sent swap landed (no signature to
  /// look up). Retrying could trade twice, so resuming re-plans instead.
  outcomeUnknown   Boolean      @default(false) @map("outcome_unknown")
  executedAt       DateTime?    @map("executed_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@unique([runId, index])
  @@map("rebalance_legs")
}

/// In-app notices (the banner), also sent by email and web push when set up.
model Notification {
  id           String      @id @default(uuid()) @db.Uuid
  owner        String
  investmentId String?     @map("investment_id") @db.Uuid
  investment   Investment? @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  kind         String
  title        String
  body         String
  url          String
  createdAt    DateTime    @default(now()) @map("created_at")
  readAt       DateTime?   @map("read_at")
  emailedAt    DateTime?   @map("emailed_at")
  pushedAt     DateTime?   @map("pushed_at")

  @@index([owner, readAt])
  @@map("notifications")
}

/// Browser push endpoints registered by a signed-in wallet.
model PushSubscription {
  endpoint  String   @id
  owner     String
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([owner])
  @@map("push_subscriptions")
}
