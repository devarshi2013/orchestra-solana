# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# --- Server-only --------------------------------------------------------------
# Jupiter Developer Platform key: https://developers.jup.ag/portal (required)
JUPITER_API_KEY=""
# Required: https://api.jup.ag (lite-api.jup.ag is being phased out and is rejected).
JUPITER_API_BASE_URL="https://api.jup.ag"
# Claude API key for the stock assistant: https://platform.claude.com (the assistant is off without it)
ANTHROPIC_API_KEY=""
# Financial Modeling Prep key for stock fundamentals: https://site.financialmodelingprep.com (optional; the assistant has no fundamentals tool without it)
MARKET_DATA_API_KEY=""
# Required: server-side Solana mainnet RPC (balances). May embed a provider key.
SOLANA_RPC_URL=""

# Strategies (off without DATABASE_URL and SESSION_SECRET).
# Neon / Vercel Postgres connection string (tables go in the "tickertape" schema).
DATABASE_URL=""
# 32+ random characters: signs wallet session cookies.
SESSION_SECRET=""
# 16+ random characters: Bearer token for /api/strategies/run (Vercel Cron sends it).
CRON_SECRET=""

# --- Browser (inlined at build time; never put secrets here) ------------------
# Required by the env check, but no longer read: trades get the block height from the server
# (/api/solana/block-height), because public RPCs answer browsers with 403.
NEXT_PUBLIC_SOLANA_RPC_URL=""
# CoinGecko, for price charts: https://www.coingecko.com/en/api (charts are off without both).
# Demo key: https://api.coingecko.com/api/v3 · Pro key: https://pro-api.coingecko.com/api/v3
COINGECKO_API_KEY=""
COINGECKO_API_BASE_URL=""
