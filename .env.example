# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# --- Server-only --------------------------------------------------------------
# Jupiter Developer Platform key: https://developers.jup.ag/portal (required)
JUPITER_API_KEY=""
# Must be api.jup.ag; lite-api.jup.ag is being phased out and is rejected. Defaults to https://api.jup.ag.
JUPITER_API_BASE_URL=""
# Claude API key for the stock assistant: https://platform.claude.com (the assistant is off without it)
ANTHROPIC_API_KEY=""
# Financial Modeling Prep key for stock fundamentals: https://site.financialmodelingprep.com (optional)
MARKET_DATA_API_KEY=""
# Resend, for the email signup: https://resend.com/api-keys (signup is off without both)
RESEND_API_KEY=""
# The audience (Resend now calls it a segment) new subscribers join: https://resend.com/audiences
RESEND_AUDIENCE_ID=""
# Server-side RPC (balances, confirmations). May embed a provider key. Defaults to the public mainnet RPC.
SOLANA_RPC_URL=""

# --- Browser (inlined at build time; never put secrets here) ------------------
# RPC for the wallet adapter. Use a public or origin-restricted endpoint. Defaults to the public mainnet RPC.
NEXT_PUBLIC_SOLANA_RPC_URL=""
