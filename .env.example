# Copy to .env.local (Next.js) and .env (Prisma CLI) — both are git-ignored.

# --- Server-only -------------------------------------------------------------
# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://orchestra:orchestra@localhost:5432/orchestra?schema=public"

# Jupiter Developer Platform key: https://developers.jup.ag/portal  (format: jup_...)
JUPITER_API_KEY=""
# Must be api.jup.ag — lite-api.jup.ag is being phased out and is rejected.
JUPITER_API_BASE_URL="https://api.jup.ag"

# Server-side RPC (balances, confirmations). May embed a provider key.
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"

# Optional Birdeye Data Services key for historical OHLCV (docs/market-data.md): https://bds.birdeye.so
# Without it, price history comes from keyless GeckoTerminal (last 180 days only).
BIRDEYE_API_KEY=""
# Stock fundamentals from Financial Modeling Prep (docs/market-tools.md): https://site.financialmodelingprep.com
MARKET_DATA_API_KEY=""
# Optional CoinGecko Demo key (higher rate limit for crypto history): https://www.coingecko.com/en/api
COINGECKO_API_KEY=""
# Signs wallet sign-in sessions (min 32 chars). Required in production; e.g. `openssl rand -hex 32`.
SESSION_SECRET=""
# Public base URL used in rebalance emails / notifications.
APP_URL="http://localhost:3000"
# Rebalance emails via Resend (optional; logged to the console when unset).
RESEND_API_KEY=""
EMAIL_FROM=""
# Web push (optional): `npx web-push generate-vapid-keys`. The public key goes in NEXT_PUBLIC_VAPID_PUBLIC_KEY.
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Bearer token for /api/cron/* (min 16 chars). Required in production; e.g. `openssl rand -hex 32`.
CRON_SECRET=""

# --- Browser (inlined at build time — never put secrets here) ---------------
# Jupiter swap APIs are mainnet-only.
NEXT_PUBLIC_SOLANA_CLUSTER="mainnet-beta"
NEXT_PUBLIC_SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Web push public VAPID key (optional, pairs with VAPID_PRIVATE_KEY).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
