{
  "name": "tickertape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "SKIP_ENV_VALIDATION=1 next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "db:migrate": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server/db/migrate.ts",
    "strategies:watch": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server/strategies/watch-dev.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-virtual": "3.14.15",
    "bs58": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "1.1.2",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.6"
  }
}
